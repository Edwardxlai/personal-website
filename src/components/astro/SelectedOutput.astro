---
import SectionHeading from './SectionHeading.astro';
import { recentWorks, featuredWorks, hasRecentWorks } from '../../data/social';
const selectedWorks = hasRecentWorks ? recentWorks : featuredWorks;
---

<section class="section container output" aria-labelledby="output">
  <SectionHeading id="output" eyebrow="Writing / Video / Notes" index="S / 04" title={hasRecentWorks ? '最近在分享' : '内容与代表作'} />
  <p class="output-note">{hasRecentWorks ? '来自各平台的近期发布，按时间倒序整理' : '以下为已收录的代表作，新内容核实后会在这里更新'}</p>

  <ol class="output-list" role="list">
    {selectedWorks.map((w, i) => (
      <li class="output-row reveal" style={`--reveal-i:${i}`}>
        <a class="output-link glare-hover" href={w.href} target="_blank" rel="noopener noreferrer" data-magnet>
          <span class="output-num">{w.slot}</span>
          <span class="output-main">
            <span class="output-platform">{w.platform}</span>
            {'date' in w && <time datetime={w.publishedAt}>{w.date}</time>}
            <span class="output-title">{w.title}</span>
          </span>
          <span class="output-stat">{w.stat}{w.stat && !('date' in w) && <small>2026.07 记录</small>}</span>
          <span class="output-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
  {hasRecentWorks && <details class="output-archive">
    <summary>以前的代表作 <span>↗</span></summary>
    <ul role="list">{featuredWorks.map(w => <li><a href={w.href} target="_blank" rel="noopener noreferrer"><span>{w.platform}</span>{w.title}<small>{w.stat} · 2026.07 记录</small></a></li>)}</ul>
  </details>}
</section>

<style>
  .output-note { margin-bottom: 24px; font-size: 13px; color: var(--text-secondary); }
  .output-stat small { display: block; margin-top: 6px; font-size: 10px; }
  time { font-size: 11px; color: var(--text-secondary); }
  .output-archive { margin-top: 32px; border-bottom: 1px solid var(--line-subtle); }
  summary { cursor: pointer; font-size: 15px; padding: 20px 0; }
  summary span { color: var(--accent); margin-left: 8px; }
  .output-archive li { border-top: 1px solid var(--line-subtle); }
  .output-archive a { display: grid; gap: 10px; padding: 20px 0; }
  .output-archive a span { color: var(--accent); font-size: 11px; }
  .output-archive small { color: var(--text-secondary); font-size: 11px; }
  .output-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line-subtle);
  }

  .output-row {
    border-bottom: 1px solid var(--line-subtle);
  }

  .output-link {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(120px, auto) 24px;
    align-items: baseline;
    gap: var(--space-6);
    padding-block: clamp(24px, 4vw, 52px);
    padding-inline: var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    --glare-radius: var(--radius-md);
  }

  .output-num {
    font-family: var(--font-mono);
    font-weight: 250;
    font-size: clamp(30px, 4vw, 56px);
    color: var(--text-tertiary);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .output-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .output-platform {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .output-title {
    font-family: var(--font-serif-cn);
    font-weight: 700;
    font-size: clamp(20px, 2.5vw, 34px);
    line-height: 1.38;
    color: var(--text-primary);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .output-stat {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .output-arrow {
    color: var(--text-tertiary);
    transition:
      color var(--dur-hover) var(--ease-out),
      transform var(--dur-hover) var(--ease-out);
  }

  @media (hover: hover) {
    a.output-link:hover .output-title,
    a.output-link:hover .output-num {
      color: var(--accent);
    }

    a.output-link:hover .output-arrow {
      color: var(--accent);
      transform: translate(4px, -4px);
    }
  }

  @media (max-width: 639px) {
    .output-link {
      grid-template-columns: 44px minmax(0, 1fr) 20px;
      gap: var(--space-4);
    }

    .output-stat {
      grid-column: 2 / 3;
      justify-self: start;
    }
  }
</style>
